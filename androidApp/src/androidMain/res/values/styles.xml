<resources>

  <!--
    Mirrors `AppTheme.NoActionBar` in the `:app` demo (a plain no-action-bar theme with a
    white primary text colour) so the two demos put their content in an identically
    configured window and can be compared pixel for pixel.
  -->
  <style name="KmpDemoTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:textColorPrimary">@android:color/white</item>
  </style>
</resources>
